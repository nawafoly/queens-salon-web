{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "queens-salon-core-api",
  "main": "workers/core/index.js",
  "compatibility_date": "2026-06-24",
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "CORE_DB",
      "database_name": "queens-salon-core",
      "database_id": "d0565103-0b29-490d-8c10-c955e8d65c4a",
      "migrations_dir": "migrations/core"
    }
  ],
  "vars": {
    "FIREBASE_PROJECT_ID": "waves-hotel-dashboard",
    "SALON_ID": "main",
    "ALLOWED_ORIGINS": "http://localhost:5173,http://127.0.0.1:5174,https://queens-salon-web.vercel.app,https://queens-salon-web-gnxk.vercel.app"
  }
}


