+    cleanTime(override?.end) ||
+    cleanTime(customDay?.end) ||
+    cleanTime(source.endTime) ||
+    cleanTime(source.end) ||
+    cleanTime(source.workEndTime) ||
+    cleanTime(source.shiftEndTime) ||
+    "17:00";
+
+  return {
+    startTime,
+    endTime,
+    weeklyOffDays: [...explicitOffDays, ...customOffDays],
