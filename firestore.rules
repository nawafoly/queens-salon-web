rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /* =========================
       Helpers
    ========================= */

    function signedIn() {
      return request.auth != null;
    }

    function isAnonymous() {
      return signedIn()
        && request.auth.token.firebase != null
        && request.auth.token.firebase.sign_in_provider == "anonymous";
    }

    function isBootstrapAdmin() {
      return signedIn() && (
        request.auth.token.email == "nawafaaa0@gmail.com" ||
        request.auth.token.email == "alolayan3@gmail.com"
      );
    }

    // ===== Paths (بدل .exists()) =====
    function myUserPath() {
      return /databases/$(database)/documents/salons/main/users/$(request.auth.uid);
    }

    function myRootUserPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function myUserPathInSalon(salonId) {
      return /databases/$(database)/documents/salons/$(salonId)/users/$(request.auth.uid);
    }

    function myAdminUserPathInSalon(salonId) {
      return /databases/$(database)/documents/salons/$(salonId)/admin_users/$(request.auth.uid);
    }

    function normRole(r) {
      return (r is string) ? r.lower() : "guest";
    }

    function tokenRole() {
      return (
        signedIn()
        && (request.auth.token.role is string)
      )
        ? normRole(request.auth.token.role)
        : "guest";
    }

    // ✅ role آمن (SOURCE OF TRUTH + fallback) - بدون .exists()
    function myRole() {
      return (
        signedIn()
        && exists(myUserPath())
        && (get(myUserPath()).data.role is string)
      )
        ? normRole(get(myUserPath()).data.role)
        : (
          signedIn()
          && exists(myRootUserPath())
          && (get(myRootUserPath()).data.role is string)
          )
            ? normRole(get(myRootUserPath()).data.role)
            : tokenRole();
    }

    function myRoleInSalon(salonId) {
      return (
        signedIn()
        && exists(myUserPathInSalon(salonId))
        && (get(myUserPathInSalon(salonId)).data.role is string)
      )
        ? normRole(get(myUserPathInSalon(salonId)).data.role)
        : (
            signedIn()
            && exists(myAdminUserPathInSalon(salonId))
            && (get(myAdminUserPathInSalon(salonId)).data.role is string)
          )
            ? normRole(get(myAdminUserPathInSalon(salonId)).data.role)
            : tokenRole();
    }

    function roleForSalon(salonId) {
      return myRoleInSalon(salonId) != "guest" ? myRoleInSalon(salonId) : myRole();
    }

    function myEmployeeIdInSalon(salonId) {
      return (
        signedIn()
        && exists(myUserPathInSalon(salonId))
        && (get(myUserPathInSalon(salonId)).data.employeeId is string)
      )
        ? get(myUserPathInSalon(salonId)).data.employeeId
        : (
            signedIn()
            && exists(myAdminUserPathInSalon(salonId))
            && (get(myAdminUserPathInSalon(salonId)).data.employeeId is string)
          )
            ? get(myAdminUserPathInSalon(salonId)).data.employeeId
            : request.auth.uid;
    }

    function userDocHasEmployeeId(d, employeeId) {
      return (
        (d.employeeId is string && d.employeeId == employeeId)
        || (d.linkedEmployeeDocId is string && d.linkedEmployeeDocId == employeeId)
      );
    }

    function employeeDocLinkedToAuth(d) {
      return (
        (d.linkedUid is string && d.linkedUid == request.auth.uid)
        || (d.uid is string && d.uid == request.auth.uid)
        || (d.linkedUserId is string && d.linkedUserId == request.auth.uid)
        || (d.employeeUid is string && d.employeeUid == request.auth.uid)
      );
    }

    function isOwnEmployeeIdForSalon(salonId, employeeId) {
      return signedIn()
        && (
          employeeId == request.auth.uid
          || employeeId == myEmployeeIdInSalon(salonId)
          || (
            exists(myUserPathInSalon(salonId))
            && userDocHasEmployeeId(
              get(myUserPathInSalon(salonId)).data,
              employeeId
            )
          )
          || (
            exists(myAdminUserPathInSalon(salonId))
            && userDocHasEmployeeId(
              get(myAdminUserPathInSalon(salonId)).data,
              employeeId
            )
          )
          || (
            exists(/databases/$(database)/documents/salons/$(salonId)/staff_public/$(employeeId))
            && employeeDocLinkedToAuth(
              get(/databases/$(database)/documents/salons/$(salonId)/staff_public/$(employeeId)).data
            )
          )
          || (
            exists(/databases/$(database)/documents/salons/$(salonId)/employees/$(employeeId))
            && employeeDocLinkedToAuth(
              get(/databases/$(database)/documents/salons/$(salonId)/employees/$(employeeId)).data
            )
          )
        );
    }

    function employeeDocHasAttendanceZone(d, zoneId) {
      return (
        (d.allowedAttendanceZoneId is string && d.allowedAttendanceZoneId == zoneId)
        || (d.attendanceZoneId is string && d.attendanceZoneId == zoneId)
        || (d.assignedAttendanceZoneId is string && d.assignedAttendanceZoneId == zoneId)
        || (d.attendanceScopeId is string && d.attendanceScopeId == zoneId)
        || (d.allowedZoneIds is list && zoneId in d.allowedZoneIds)
        || (
          d.employment is map
          && (
            (d.employment.allowedAttendanceZoneId is string && d.employment.allowedAttendanceZoneId == zoneId)
            || (d.employment.attendanceZoneId is string && d.employment.attendanceZoneId == zoneId)
            || (d.employment.assignedAttendanceZoneId is string && d.employment.assignedAttendanceZoneId == zoneId)
            || (d.employment.attendanceScopeId is string && d.employment.attendanceScopeId == zoneId)
            || (d.employment.allowedZoneIds is list && zoneId in d.employment.allowedZoneIds)
          )
        )
        || (
          d.employeeProfile is map
          && d.employeeProfile.employment is map
          && (
            (d.employeeProfile.employment.allowedAttendanceZoneId is string && d.employeeProfile.employment.allowedAttendanceZoneId == zoneId)
            || (d.employeeProfile.employment.attendanceZoneId is string && d.employeeProfile.employment.attendanceZoneId == zoneId)
            || (d.employeeProfile.employment.assignedAttendanceZoneId is string && d.employeeProfile.employment.assignedAttendanceZoneId == zoneId)
            || (d.employeeProfile.employment.attendanceScopeId is string && d.employeeProfile.employment.attendanceScopeId == zoneId)
            || (d.employeeProfile.employment.allowedZoneIds is list && zoneId in d.employeeProfile.employment.allowedZoneIds)
          )
        )
      );
    }

    function isMyAssignedAttendanceZoneForSalon(salonId, zoneId) {
      return signedIn()
        && (
          (
            exists(/databases/$(database)/documents/salons/$(salonId)/staff_public/$(myEmployeeIdInSalon(salonId)))
            && employeeDocHasAttendanceZone(
              get(/databases/$(database)/documents/salons/$(salonId)/staff_public/$(myEmployeeIdInSalon(salonId))).data,
              zoneId
            )
          )
          || (
            exists(/databases/$(database)/documents/salons/$(salonId)/employees/$(myEmployeeIdInSalon(salonId)))
            && employeeDocHasAttendanceZone(
              get(/databases/$(database)/documents/salons/$(salonId)/employees/$(myEmployeeIdInSalon(salonId))).data,
              zoneId
            )
          )
        );
    }

    function isOwner() { return myRole() == "owner"; }
    function isAdmin() { return myRole() == "admin"; }
    function isHr() { return myRole() == "hr"; }
    function isReception() { return myRole() == "reception"; }
    function isStaff() { return myRole() == "staff"; }
    function isAccountant() { return myRole() == "accountant"; } // (تحذير Unused عادي لو ما تستخدمه)

    function isAdminPower() {
      return isBootstrapAdmin() || isOwner() || isAdmin();
    }

    function canEditBookings() {
      return isAdminPower() || isReception();
    }

    function isHrLeaveBalanceUpdateForSalon(salonId) {
      return signedIn()
        && roleForSalon(salonId) == "hr"
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "leaveBalanceDays",
          "leaveEntries",
          "leaveEntitlementDate",
          "updatedAt"
        ]);
    }

    function isHrManagementForSalon(salonId) {
      return isBootstrapAdmin() || roleForSalon(salonId) in ["owner", "admin", "hr"];
    }

    function canManageAttendanceForSalon(salonId) {
      return signedIn()
        && (
          isBootstrapAdmin()
          || roleForSalon(salonId) in ["owner","admin","hr","reception"]
        );
    }

    function isOwnAttendanceBaseWrite(salonId, employeeId, dateId) {
      return signedIn()
        && isOwnEmployeeIdForSalon(salonId, employeeId)
        && request.resource.data.employeeId == employeeId
        && request.resource.data.date == dateId
        && request.resource.data.salonId == salonId
        && request.resource.data.status in ["checked_in", "checked_out"];
    }

    function isOwnAttendanceCheckInCreate(salonId, employeeId, dateId) {
      return isOwnAttendanceBaseWrite(salonId, employeeId, dateId)
        && request.resource.data.status == "checked_in"
        && request.resource.data.keys().hasOnly([
          "date",
          "employeeId",
          "salonId",
          "status",
          "checkInAt",
          "checkInAtClient",
          "createdBy",
          "checkInVerification",
          "createdAt",
          "updatedAt"
        ])
        && request.resource.data.createdBy is map
        && request.resource.data.createdBy.uid == request.auth.uid;
    }

    function isOwnAttendanceCheckOutUpdate(salonId, employeeId, dateId) {
      return isOwnAttendanceBaseWrite(salonId, employeeId, dateId)
        && resource.data.employeeId == employeeId
        && resource.data.date == dateId
        && resource.data.salonId == salonId
        && resource.data.status == "checked_in"
        && request.resource.data.status == "checked_out"
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "status",
          "checkOutAt",
          "checkOutAtClient",
          "updatedBy",
          "checkOutVerification",
          "updatedAt"
        ])
        && request.resource.data.updatedBy is map
        && request.resource.data.updatedBy.uid == request.auth.uid;
    }

    function isEmployeeManagementForSalon(salonId) {
      return isBootstrapAdmin() || roleForSalon(salonId) in ["owner", "admin", "hr", "reception", "staff"];
    }

    function isOwnStaffBookingDoc(d) {
      return (
        (
          (d.employeeUid is string)
          && d.employeeUid == request.auth.uid
        )
        || (
          (d.employeeKey is string)
          && d.employeeKey == request.auth.uid
        )
      );
    }

    function allowStaffStatusChangeInSalon(salonId) {
      return (
        exists(/databases/$(database)/documents/salons/$(salonId)/settings/app)
        && (
          get(/databases/$(database)/documents/salons/$(salonId)/settings/app)
            .data.policies.allowStaffChangeStatus == true
        )
      );
    }

    function isGuestish() {
      return !signedIn() || isAnonymous();
    }

    /* =========================
       Flexible payload helpers
    ========================= */

    function hasServiceRef() {
      return (request.resource.data.serviceName is string)
        || (request.resource.data.serviceId is string);
    }

    function hasEmployeeRef() {
      return (request.resource.data.employeeName is string)
        || (request.resource.data.employeeId is string)
        || (request.resource.data.employeeUid is string);
    }

    function isNumberField(v) {
      return (v is int) || (v is float);
    }

    function isGuestClientBookingCreate() {
      return isGuestish()
        && request.resource.data.createdBy == "client"
        && request.resource.data.channel == "client"
        && request.resource.data.status in ["pending", "new"]
        && (request.resource.data.clientName is string)
        && (request.resource.data.clientPhone is string)
        && hasServiceRef()
        && hasEmployeeRef()
        && (request.resource.data.date is string)
        && (request.resource.data.time is string)
        && (request.resource.data.slotId is string)
        && isNumberField(request.resource.data.total)
        && isNumberField(request.resource.data.finalPrice);
    }

    function isSignedInClientBookingCreate() {
      return signedIn()
        && !isAnonymous()
        && request.resource.data.createdBy == "client"
        && request.resource.data.channel == "client"
        && request.resource.data.status in ["pending", "new"]
        && (request.resource.data.userId is string)
        && request.resource.data.userId == request.auth.uid
        && (request.resource.data.clientName is string)
        && (request.resource.data.clientPhone is string)
        && hasServiceRef()
        && hasEmployeeRef()
        && (request.resource.data.date is string)
        && (request.resource.data.time is string)
        && (request.resource.data.slotId is string)
        && isNumberField(request.resource.data.total)
        && isNumberField(request.resource.data.finalPrice);
    }

    function isGuestSlotLockCreate(slotId) {
      return isGuestish()
        && !exists(/databases/$(database)/documents/salons/main/booking_slots/$(slotId))
        && (request.resource.data.bookingId is string)
        && (request.resource.data.date is string)
        && (request.resource.data.time is string)
        && hasEmployeeRef();
    }

    /* =========================
       users (OLD ROOT)
    ========================= */
    match /users/{uid} {
      allow read: if signedIn() && (
        request.auth.uid == uid || isBootstrapAdmin() || isOwner()
      );
      allow write: if signedIn() && (isBootstrapAdmin() || isOwner());
    }

    /* =========================
       ✅ salons/{salonId}/users/{uid}
       (مهم: بدون recursion)
    ========================= */
    match /salons/{salonId}/users/{uid} {

      allow read: if signedIn() && (
        request.auth.uid == uid
        || isBootstrapAdmin()
        || (
          exists(myUserPathInSalon(salonId))
          && (get(myUserPathInSalon(salonId)).data.role is string)
          && normRole(get(myUserPathInSalon(salonId)).data.role)
            in ["owner","admin","reception","hr"]
        )
      );

      allow create: if signedIn() && (
        request.auth.uid == uid
        || isBootstrapAdmin()
        || (
          exists(myUserPathInSalon(salonId))
          && normRole(get(myUserPathInSalon(salonId)).data.role) in ["owner","admin","reception","hr"]
        )
      );

      allow update: if signedIn() && (
        (
          request.auth.uid == uid
          // client can only update own profile, without escalating privileges
          && request.resource.data.role == resource.data.role
          && (!("active" in request.resource.data) || request.resource.data.active == resource.data.active)
          && (!("isAdmin" in request.resource.data) || request.resource.data.isAdmin == resource.data.isAdmin)
          && (!("owner" in request.resource.data) || request.resource.data.owner == resource.data.owner)
          && (!("permissions" in request.resource.data) || request.resource.data.permissions == resource.data.permissions)
          && (!("canManageUsers" in request.resource.data) || request.resource.data.canManageUsers == resource.data.canManageUsers)
          && (!("canManageBookings" in request.resource.data) || request.resource.data.canManageBookings == resource.data.canManageBookings)
          && (!("canManageStaff" in request.resource.data) || request.resource.data.canManageStaff == resource.data.canManageStaff)
        )
        || isBootstrapAdmin()
        || (
          exists(myUserPathInSalon(salonId))
          && normRole(get(myUserPathInSalon(salonId)).data.role) in ["owner","admin","reception","hr"]
        )
      );

      allow delete: if signedIn() && (
        isBootstrapAdmin()
        || (
          exists(myUserPathInSalon(salonId))
          && normRole(get(myUserPathInSalon(salonId)).data.role) in ["owner","admin","hr"]
        )
      );
    }

    /* =========================
       ✅ user_invites
    ========================= */
    match /salons/{salonId}/user_invites/{inviteId} {
      allow read: if signedIn() && (
        isBootstrapAdmin()
        || roleForSalon(salonId) in ["owner","admin","reception"]
        || (
          request.auth.token.email is string
          && resource.data.email is string
          && request.auth.token.email.lower() == resource.data.email.lower()
        )
      );

      allow create: if signedIn()
        && (isBootstrapAdmin() || roleForSalon(salonId) in ["owner","admin"])
        && (request.resource.data.email is string)
        && (request.resource.data.role is string)
        && (request.resource.data.active is bool)
        && request.resource.data.keys().hasAll(["email","role","active"]);

      allow update, delete: if signedIn()
        && (isBootstrapAdmin() || roleForSalon(salonId) in ["owner","admin"]);
    }

    /* =========================
       ✅ settings
    ========================= */
    match /settings/{id} {
      allow read: if true;
      allow write: if signedIn() && isAdminPower();
    }

    match /salons/{salonId}/settings/{id} {
      allow read: if true;
      allow write: if signedIn() && (isBootstrapAdmin() || roleForSalon(salonId) in ["owner","admin"]);
    }

    match /salons/{salonId}/work_zones/{id} {
      allow read: if signedIn() && (
        isBootstrapAdmin()
        || roleForSalon(salonId) in ["owner","admin","hr","reception"]
        || isMyAssignedAttendanceZoneForSalon(salonId, id)
      );
      allow create, update, delete: if signedIn()
        && (isBootstrapAdmin() || roleForSalon(salonId) in ["owner","admin","hr"]);
    }

    /* =========================
       staff_public (ROOT)
    ========================= */
    match /staff_public/{uid} {
      allow read: if true;
      allow write: if signedIn() && isAdminPower();
    }

    /* =========================
       ✅ salons/{salonId}/staff_public/{uid}
       ✅ FIX endsWith -> matches
    ========================= */
    match /salons/{salonId}/staff_public/{uid} {
      allow read: if true;

      allow write: if signedIn() && (
        isBootstrapAdmin() || roleForSalon(salonId) in ["owner","admin","reception"]
      );

      // HR can edit employee profile data, but delete stays limited to the admin/reception path above.
      allow create, update: if signedIn() && (
        isBootstrapAdmin() || roleForSalon(salonId) in ["owner","admin","reception","hr"]
      );

      allow update: if isHrLeaveBalanceUpdateForSalon(salonId);

      allow create: if signedIn()
        && request.auth.token.email is string
        && request.auth.token.email.lower().matches(".*@malikat\\.com$")
        && request.resource.data.keys().hasOnly([
          "email",
          "linkedUid",
          "role",
          "active",
          "name",
          "phone",
          "showOnAbout",
          "showOnBooking",
          "createdAt",
          "updatedAt"
        ])
        && request.resource.data.email is string
        && request.resource.data.email.lower() == request.auth.token.email.lower()
        && request.resource.data.linkedUid == request.auth.uid
        && request.resource.data.role == "pending"
        && request.resource.data.active == false;

      allow update: if signedIn()
        && request.auth.token.email is string
        && request.auth.token.email.lower().matches(".*@malikat\\.com$")
        && resource.data.linkedUid == request.auth.uid
        && (
          (!("role" in request.resource.data) || request.resource.data.role == resource.data.role)
          && (!("active" in request.resource.data) || request.resource.data.active == resource.data.active)
        );
    }

    /* =========================
       HR collections
    ========================= */
    match /salons/{salonId}/employees/{employeeId} {
      allow read: if signedIn() && (
        isEmployeeManagementForSalon(salonId)
        || (resource.data.uid is string && resource.data.uid == request.auth.uid)
        || (resource.data.linkedUid is string && resource.data.linkedUid == request.auth.uid)
        || (resource.data.employeeId is string && resource.data.employeeId == request.auth.uid)
      );

      allow create: if signedIn() && (
        isHrManagementForSalon(salonId)
        || (
          roleForSalon(salonId) in ["owner", "admin", "hr", "reception", "staff"]
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.linkedUid == request.auth.uid
          && request.resource.data.employeeId == employeeId
          && request.resource.data.role == roleForSalon(salonId)
        )
      );

      allow update: if signedIn() && (
        isHrManagementForSalon(salonId)
        || (
          request.resource.data.uid == request.auth.uid
          && request.resource.data.linkedUid == request.auth.uid
          && request.resource.data.employeeId == employeeId
          && request.resource.data.role == resource.data.role
          && request.resource.data.active == resource.data.active
          && request.resource.data.isActive == resource.data.isActive
          && request.resource.data.removedFromStaff == resource.data.removedFromStaff
          && request.resource.data.employmentStatus == resource.data.employmentStatus
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "name",
            "displayName",
            "phone",
            "department",
            "title",
            "avatarUrl",
            "bio",
            "specialties",
            "employeeProfileEnabled",
            "showOnAbout",
            "showOnBooking",
            "email",
            "userEmail",
            "updatedAt"
          ])
        )
      );

      allow delete: if signedIn() && isHrManagementForSalon(salonId);
    }

    match /salons/{salonId}/admin_users/{uid} {
      allow read: if signedIn() && (
        isHrManagementForSalon(salonId)
        || (resource.data.uid is string && resource.data.uid == request.auth.uid)
        || (resource.data.employeeId is string && resource.data.employeeId == request.auth.uid)
      );

      allow create: if signedIn() && (
        isHrManagementForSalon(salonId)
        || (
          roleForSalon(salonId) in ["owner", "admin", "hr", "reception", "staff"]
          && request.resource.data.uid == request.auth.uid
        )
      );

      allow update: if signedIn() && (
        isHrManagementForSalon(salonId)
        || (
          request.resource.data.uid == request.auth.uid
          && request.resource.data.role == resource.data.role
          && request.resource.data.active == resource.data.active
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "displayName",
            "name",
            "phone",
            "email",
            "employeeId",
            "updatedAt"
          ])
        )
      );

      allow delete: if signedIn() && isHrManagementForSalon(salonId);
    }

    match /salons/{salonId}/employee_messages/{messageId} {
      allow read: if signedIn() && (
        isHrManagementForSalon(salonId)
        || (resource.data.senderUid is string && resource.data.senderUid == request.auth.uid)
        || (resource.data.recipientUid is string && resource.data.recipientUid == request.auth.uid)
      );

      allow create: if signedIn() && (
        isHrManagementForSalon(salonId)
        || (
          request.resource.data.senderUid is string
          && request.resource.data.senderUid == request.auth.uid
          && request.resource.data.recipientUid is string
          && request.resource.data.conversationId is string
          && request.resource.data.body is string
        )
      );

      allow update: if signedIn() && (
        isHrManagementForSalon(salonId)
        || (resource.data.senderUid is string && resource.data.senderUid == request.auth.uid)
        || (resource.data.recipientUid is string && resource.data.recipientUid == request.auth.uid)
      ) && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        "readBy",
        "updatedAt"
      ]);

      allow delete: if signedIn() && isHrManagementForSalon(salonId);
    }

    match /salons/{salonId}/employee_files/{fileId} {
      allow read: if signedIn() && (
        isHrManagementForSalon(salonId)
        || (resource.data.employeeUid is string && resource.data.employeeUid == request.auth.uid)
        || (resource.data.createdByUid is string && resource.data.createdByUid == request.auth.uid)
      );

      allow create: if signedIn() && (
        isHrManagementForSalon(salonId)
        || (
          request.resource.data.employeeUid is string
          && request.resource.data.employeeUid == request.auth.uid
        )
      );

      allow update: if signedIn() && (
        isHrManagementForSalon(salonId)
        || (resource.data.employeeUid is string && resource.data.employeeUid == request.auth.uid)
        || (resource.data.createdByUid is string && resource.data.createdByUid == request.auth.uid)
      ) && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        "status",
        "notes",
        "readBy",
        "updatedAt"
      ]);

      allow delete: if signedIn() && isHrManagementForSalon(salonId);
    }

    match /salons/{salonId}/employee_leave_requests/{requestId} {
      allow read: if signedIn() && (
        isHrManagementForSalon(salonId)
        || (resource.data.employeeUid is string && resource.data.employeeUid == request.auth.uid)
        || (resource.data.createdByUid is string && resource.data.createdByUid == request.auth.uid)
      );

      allow create: if signedIn() && (
        isHrManagementForSalon(salonId)
        || (
          request.resource.data.employeeUid is string
          && request.resource.data.employeeUid == request.auth.uid
        )
      );

      allow update, delete: if signedIn() && isHrManagementForSalon(salonId);
    }

    match /salons/{salonId}/employee_absences/{absenceId} {
      allow read: if signedIn() && (
        isEmployeeManagementForSalon(salonId)
        || (resource.data.employeeUid is string && resource.data.employeeUid == request.auth.uid)
      );

      allow write: if signedIn() && isHrManagementForSalon(salonId);
    }

    match /salons/{salonId}/employee_payroll_records/{recordId} {
      allow read: if signedIn() && (
        isEmployeeManagementForSalon(salonId)
        || (resource.data.employeeUid is string && resource.data.employeeUid == request.auth.uid)
      );

      allow write: if signedIn() && isHrManagementForSalon(salonId);
    }

    match /salons/{salonId}/notifications/{notificationId} {
      allow read: if signedIn() && (
        isHrManagementForSalon(salonId)
        || (resource.data.targetUid is string && resource.data.targetUid == request.auth.uid)
        || (
          resource.data.targetEmployeeId is string
          && resource.data.targetEmployeeId == request.auth.uid
        )
      );

      allow create: if signedIn() && (
        isHrManagementForSalon(salonId)
        || (
          (request.resource.data.targetUid is string && request.resource.data.targetUid == request.auth.uid)
          || (
            request.resource.data.targetEmployeeId is string
            && request.resource.data.targetEmployeeId == request.auth.uid
          )
        )
      );

      allow update: if signedIn() && (
        isHrManagementForSalon(salonId)
        || (resource.data.targetUid is string && resource.data.targetUid == request.auth.uid)
        || (
          resource.data.targetEmployeeId is string
          && resource.data.targetEmployeeId == request.auth.uid
        )
      ) && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        "isRead",
        "readAt",
        "readBy",
        "updatedAt"
      ]);

      allow delete: if signedIn() && isHrManagementForSalon(salonId);
    }

    match /salons/{salonId}/weekly_reports/{reportId} {
      allow read: if signedIn() && (
        isHrManagementForSalon(salonId)
        || (resource.data.recipientUid is string && resource.data.recipientUid == request.auth.uid)
        || (
          resource.data.recipientEmail is string
          && request.auth.token.email is string
          && resource.data.recipientEmail.lower() == request.auth.token.email.lower()
        )
      );

      allow write: if signedIn() && isHrManagementForSalon(salonId);
    }

    match /salons/{salonId}/job_applications/{applicationId} {
      allow read, create, update, delete: if signedIn() && isHrManagementForSalon(salonId);
    }

    /* =========================
       bookings (ROOT legacy)
    ========================= */
    match /bookings/{id} {
      allow create: if canEditBookings()
        || (
          signedIn()
          && request.resource.data.channel == "client"
          && request.resource.data.status == "pending"
        );

      allow read: if canEditBookings()
        || isStaff()
        || (signedIn() && resource.data.userId == request.auth.uid);

      allow update: if canEditBookings();
      allow delete: if signedIn() && (isBootstrapAdmin() || isOwner());
    }

    /* =========================
       ✅ salons scoped data (ACTUAL USED)
    ========================= */

    match /salons/{salonId}/bookings/{id} {

      allow read: if signedIn() && (
        isBootstrapAdmin()
        || roleForSalon(salonId) in ["owner","admin","reception","accountant"]

        // ✅ العميل يشوف حجوزه فقط
        || (resource.data.userId is string && resource.data.userId == request.auth.uid)

        // ✅ staff يشوف حجوزاته فقط (حتى لو pending/new)
        || (
          roleForSalon(salonId) == "staff"
          && isOwnStaffBookingDoc(resource.data)
        )

        // ✅ staff: confirmed + completed فقط (القديم) إذا تبغاه يظل شغال
        || (
          roleForSalon(salonId) == "staff"
          && (resource.data.status in ["confirmed","completed"])
        )
      );

      allow create: if
        isGuestClientBookingCreate()
        || isSignedInClientBookingCreate()
        || (signedIn() && (isBootstrapAdmin() || roleForSalon(salonId) in ["owner","admin","reception"]));

      allow update: if signedIn() && (
        isBootstrapAdmin()
        || roleForSalon(salonId) in ["owner","admin","reception"]
        || (
          roleForSalon(salonId) == "staff"
          && isOwnStaffBookingDoc(resource.data)
          && (
            (
              request.resource.data.diff(resource.data).changedKeys()
                .hasOnly(["staffAck","staffAckAt","staffAckByUid","updatedAt"])
              && request.resource.data.staffAck == true
              && (request.resource.data.staffAckByUid is string)
              && request.resource.data.staffAckByUid == request.auth.uid
            )
            || (
              allowStaffStatusChangeInSalon(salonId)
              && request.resource.data.diff(resource.data).changedKeys()
                .hasOnly([
                  "status",
                  "confirmedAt","confirmedByUid",
                  "completedAt","completedByUid",
                  "cancelledAt","cancelledByUid",
                  "updatedAt"
                ])
              && request.resource.data.status in ["confirmed","completed","cancelled"]
              && (
                (
                  request.resource.data.status == "confirmed"
                  && (request.resource.data.confirmedByUid is string)
                  && request.resource.data.confirmedByUid == request.auth.uid
                )
                || (
                  request.resource.data.status == "completed"
                  && (request.resource.data.completedByUid is string)
                  && request.resource.data.completedByUid == request.auth.uid
                )
                || (
                  request.resource.data.status == "cancelled"
                  && (request.resource.data.cancelledByUid is string)
                  && request.resource.data.cancelledByUid == request.auth.uid
                )
              )
            )
          )
        )
      );

      // Permanent booking delete is restricted to owner only (and bootstrap admin).
      allow delete: if signedIn() && (
        isBootstrapAdmin() || roleForSalon(salonId) == "owner"
      );
    }

    match /salons/{salonId}/booking_logs/{bookingId}/events/{eventId} {
      allow read: if signedIn() && (
        isBootstrapAdmin()
        || roleForSalon(salonId) in ["owner","admin","reception","accountant"]
        || (
          roleForSalon(salonId) == "staff"
          && exists(/databases/$(database)/documents/salons/$(salonId)/bookings/$(bookingId))
          && (
            (
              get(/databases/$(database)/documents/salons/$(salonId)/bookings/$(bookingId)).data.employeeUid is string
            )
            && get(/databases/$(database)/documents/salons/$(salonId)/bookings/$(bookingId)).data.employeeUid == request.auth.uid
            || (
              get(/databases/$(database)/documents/salons/$(salonId)/bookings/$(bookingId)).data.employeeKey is string
            )
            && get(/databases/$(database)/documents/salons/$(salonId)/bookings/$(bookingId)).data.employeeKey == request.auth.uid
          )
        )
      );

      allow create: if signedIn() && !isAnonymous() && (
        isBootstrapAdmin()
        || roleForSalon(salonId) in ["owner","admin","reception"]
        || (
          roleForSalon(salonId) == "staff"
          && exists(/databases/$(database)/documents/salons/$(salonId)/bookings/$(bookingId))
          && (
            (
              get(/databases/$(database)/documents/salons/$(salonId)/bookings/$(bookingId)).data.employeeUid is string
            )
            && get(/databases/$(database)/documents/salons/$(salonId)/bookings/$(bookingId)).data.employeeUid == request.auth.uid
            || (
              get(/databases/$(database)/documents/salons/$(salonId)/bookings/$(bookingId)).data.employeeKey is string
            )
            && get(/databases/$(database)/documents/salons/$(salonId)/bookings/$(bookingId)).data.employeeKey == request.auth.uid
          )
          && (request.resource.data.byUid is string)
          && request.resource.data.byUid == request.auth.uid
        )
      );

      allow update, delete: if false;
    }

    match /salons/{salonId}/booking_slots/{slotId} {
      allow read: if true;

      allow create: if (
        (signedIn()
          && !exists(/databases/$(database)/documents/salons/$(salonId)/booking_slots/$(slotId))
        )
        || isGuestSlotLockCreate(slotId)
      );

      allow update: if false;

      allow delete: if signedIn() && (
        isBootstrapAdmin() || roleForSalon(salonId) in ["owner","admin","reception"]
      );
    }

    /* =========================
       ✅ Aggregated Availability (availability_days)
       - One doc per employee/day
       - Used by Booking pages to reduce reads
    ========================= */
    match /salons/{salonId}/availability_days/{dateISO}/employees/{employeeId} {
      allow read: if true;

      function canAdminWriteAvailabilityDay() {
        return signedIn() && (
          isBootstrapAdmin() || roleForSalon(salonId) in ["owner","admin","reception"]
        );
      }

      // Non-admin writes are only allowed to ADD bookings (no deletions) and must not change `complete`.
      function isBookingActorAvailabilityUpsert() {
        return request.resource.data.date == dateISO
          && request.resource.data.employeeId == employeeId
          && (request.resource.data.employeeKey is string)
          && (request.resource.data.bookedSlots is map);
      }

      allow create: if canAdminWriteAvailabilityDay()
        || (
          isBookingActorAvailabilityUpsert()
          && (request.resource.data.complete == false)
        );

      allow update: if canAdminWriteAvailabilityDay()
        || (
          isBookingActorAvailabilityUpsert()
          && (
            (!("complete" in request.resource.data) && !("complete" in resource.data))
            || request.resource.data.complete == resource.data.complete
          )
          && (resource.data.bookedSlots is map)
          && request.resource.data.bookedSlots.keys().hasAll(resource.data.bookedSlots.keys())
        );

      allow delete: if canAdminWriteAvailabilityDay();
    }

    /* =========================
       ✅ counters (for publicId)
    ========================= */
    match /salons/{salonId}/counters/{id} {
      allow read: if true;

      allow create, update: if
        id == "bookings"
        && request.resource.data.keys().hasOnly(["next"])
        && (request.resource.data.next is int)
        && (
          (!exists(/databases/$(database)/documents/salons/$(salonId)/counters/$(id))
            && request.resource.data.next >= 10001)
          ||
          (exists(/databases/$(database)/documents/salons/$(salonId)/counters/$(id))
            && request.resource.data.next == resource.data.next + 1)
        );

      allow delete: if false;
    }

    match /salons/{salonId}/booking_tracks/{id} {
      allow read: if true;

      allow create: if signedIn()
        && (request.resource.data.bookingId is string)
        && request.resource.data.bookingId == id
        && (
          (request.resource.data.serviceName is string) ||
          (request.resource.data.serviceId is string)
        )
        && (
          (request.resource.data.employeeName is string) ||
          (request.resource.data.employeeId is string) ||
          (request.resource.data.employeeUid is string)
        )
        && (request.resource.data.date is string)
        && (request.resource.data.time is string)
        && (request.resource.data.status in ["pending", "confirmed", "completed", "cancelled"])
        && (!("userId" in request.resource.data) || request.resource.data.userId == request.auth.uid);

      allow write: if signedIn() && (
        isBootstrapAdmin()
        || roleForSalon(salonId) in ["owner","admin","reception","staff"]
      );
    }

    match /salons/{salonId}/expenses/{id} {
      allow read, write: if signedIn() && (
        isBootstrapAdmin() || roleForSalon(salonId) in ["owner","admin","accountant"]
      );
    }

    match /salons/{salonId}/income/{id} {
      allow read, write: if signedIn() && (
        isBootstrapAdmin() || roleForSalon(salonId) in ["owner","admin","accountant","reception"]
      );
    }

    match /salons/{salonId}/staff/{employeeId}/attendance/{dateId} {
      allow get: if canManageAttendanceForSalon(salonId)
        || roleForSalon(salonId) == "accountant"
        || isOwnEmployeeIdForSalon(salonId, employeeId);

      allow list: if canManageAttendanceForSalon(salonId)
        || roleForSalon(salonId) == "accountant"
        || isOwnEmployeeIdForSalon(salonId, employeeId);

      allow create: if canManageAttendanceForSalon(salonId)
        || isOwnAttendanceCheckInCreate(salonId, employeeId, dateId);

      allow update: if canManageAttendanceForSalon(salonId)
        || isOwnAttendanceCheckOutUpdate(salonId, employeeId, dateId);

      allow delete: if canManageAttendanceForSalon(salonId);
    }

    match /salons/{salonId}/service_sections/{id} {
      allow read: if true;
      allow create, update, delete: if signedIn() && (
        isBootstrapAdmin() || roleForSalon(salonId) in ["owner","admin","reception"]
      );
    }

    match /salons/{salonId}/service_categories/{id} {
      allow read: if true;
      allow create, update, delete: if signedIn() && (
        isBootstrapAdmin() || roleForSalon(salonId) in ["owner","admin","reception"]
      );
    }

    match /salons/{salonId}/services/{id} {
      allow read: if true;
      allow create, update, delete: if signedIn() && (
        isBootstrapAdmin() || roleForSalon(salonId) in ["owner","admin","reception"]
      );
    }


        /* =========================
       ✅ logs (Audit Log)
       /salons/{salonId}/logs/{logId}
       - Immutable: create only
       - Read: owner/admin only
    ========================= */
    match /salons/{salonId}/logs/{logId} {

      // Read-only for owner/admin only
      allow read: if signedIn() && (
        isBootstrapAdmin() || roleForSalon(salonId) in ["owner", "admin"]
      );

      // Create only:
      // - staff/admin flows (existing behavior)
      // - client logs with strict constraints (own uid + limited actions)
      // Keep immutable audit trail (no update/delete)
      allow create: if signedIn() && !isAnonymous() && (
        isBootstrapAdmin()
        || roleForSalon(salonId) in ["owner", "admin", "reception", "staff"]
        || (
          roleForSalon(salonId) in ["client", "guest"]
          && (request.resource.data.userId is string)
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.entityType == "client"
          && request.resource.data.action in ["user_login", "client_updated"]
        )
      );

      allow update, delete: if false;
    }


    /* =========================
       ✅ testimonials
       /salons/{salonId}/testimonials/{tid}
    ========================= */
    match /salons/{salonId}/testimonials/{tid} {

      // الناس: يقرون المعتمد فقط
      allow get, list: if resource.data.approved == true
        && resource.data.hidden != true;

      // الإدارة: تقرأ الكل + تتحكم
      allow get, list: if signedIn() && (
        isBootstrapAdmin() || roleForSalon(salonId) in ["owner","admin","reception"]
      );

      // أي مستخدم مسجل دخول (عادي أو anonymous) يكتب تعليق
      allow create: if signedIn()
        && (request.resource.data.uid is string)
        && request.resource.data.uid == request.auth.uid
        && (
          request.resource.data.approved == false
          || request.resource.data.approved == true
        )
        && (!("hidden" in request.resource.data) || request.resource.data.hidden == false);

      // الإدارة فقط: اعتماد/إخفاء/رد/حذف
      allow update, delete: if signedIn() && (
        isBootstrapAdmin() || roleForSalon(salonId) in ["owner","admin","reception"]
      );
    }

    // catch-all لأي كولكشن ثانية داخل salon (اختياري)
    match /salons/{salonId}/{colName}/{docId} {
      allow read, write: if signedIn() && (
        colName != "staff_public"
        && colName != "service_sections"
        && colName != "service_categories"
        && colName != "services"
        && colName != "booking_slots"
        && colName != "booking_tracks"
        && colName != "testimonials"
        && colName != "settings"
        && colName != "bookings"
        && colName != "users"
        && colName != "user_invites"
        && colName != "income"
        && colName != "expenses"
        && colName != "logs"
        && colName != "employees"
        && colName != "admin_users"
        && colName != "employee_messages"
        && colName != "employee_files"
        && colName != "employee_leave_requests"
        && colName != "employee_absences"
        && colName != "employee_payroll_records"
        && colName != "notifications"
        && colName != "weekly_reports"
        && colName != "job_applications"
        && (isBootstrapAdmin() || roleForSalon(salonId) in ["owner","admin","reception"])
      );
    }
  }
  
}
