.employee-profile-page .emp-svc-hero p {
  max-width: 680px;
  margin: 5px 0 0;
  color: var(--profile-muted);
  font-size: 13px;
  line-height: 1.7;
}

.employee-profile-page .emp-svc-stats {
  display: grid;
  grid-template-columns: repeat(2, minmax(96px, 1fr));
  gap: 8px;
  flex: 0 0 auto;
}

.employee-profile-page .emp-svc-stats > div {
  display: grid;
  min-height: 64px;
  place-content: center;
  gap: 1px;
  padding: 8px 13px;
  border: 1px solid #e1e5ea;
  border-radius: 12px;
  color: #566276;
  background: #f8fafb;
  text-align: center;
}

.employee-profile-page .emp-svc-stats > div.is-primary {
  border-color: rgba(90, 7, 24, 0.16);
  color: var(--profile-primary);
  background: var(--profile-primary-soft);
}

.employee-profile-page .emp-svc-stats strong {
  font-size: 20px;
  font-weight: 950;
  line-height: 1;
}

.employee-profile-page .emp-svc-stats span {
  font-size: 11px;
  font-weight: 850;
}

.employee-profile-page .emp-svc-controlbar {
  display: grid;
  grid-template-columns: minmax(250px, 1.5fr) minmax(180px, 0.75fr) auto auto;
  align-items: end;
  gap: 10px;
  min-width: 0;
  padding: 12px;
  border: 1px solid #e1e5ea;
  border-radius: 14px;
  background: #fff;
}

.employee-profile-page .emp-svc-field {
  display: grid;
  min-width: 0;
  gap: 6px;
}

.employee-profile-page .emp-svc-field > span,
.employee-profile-page .emp-svc-selected-search > span {
  color: #59667a;
  font-size: 11px;
  font-weight: 900;
}

.employee-profile-page .emp-svc-field input,
.employee-profile-page .emp-svc-selected-search input {
  width: 100%;
  min-width: 0;
  height: 42px;
  padding: 0 12px;
  border: 1px solid #dbe1e8;
  border-radius: 10px;
  color: #172033;
  background: #fbfcfd;
  outline: none;
}

.employee-profile-page .emp-svc-field input:focus,
.employee-profile-page .emp-svc-selected-search input:focus {
  border-color: rgba(90, 7, 24, 0.42);
  background: #fff;
  box-shadow: 0 0 0 3px rgba(90, 7, 24, 0.07);
}

.employee-profile-page .emp-svc-field--section > div,
.employee-profile-page .emp-svc-field--section button {
  min-height: 42px;
}

.employee-profile-page .emp-svc-view-tabs {
  display: grid;
  grid-template-columns: repeat(2, minmax(88px, 1fr));
  gap: 4px;
  min-height: 42px;
  padding: 4px;
  border: 1px solid #dfe4ea;
  border-radius: 11px;
  background: #f4f6f8;
}

.employee-profile-page .emp-svc-view-tabs button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 7px;
  min-height: 34px;
  padding: 0 10px;
  border: 0;
  border-radius: 8px;
  color: #647086;
  background: transparent;
  font-size: 12px;
  font-weight: 900;
  cursor: pointer;
}

.employee-profile-page .emp-svc-view-tabs button b {
  display: grid;
  min-width: 22px;
  height: 22px;
  place-items: center;
  padding: 0 5px;
  border-radius: 999px;
  background: #fff;
  font-size: 10px;
}

.employee-profile-page .emp-svc-view-tabs button.is-active {
  color: #fff;
  background: var(--profile-primary);
  box-shadow: 0 5px 12px rgba(90, 7, 24, 0.17);
}

.employee-profile-page .emp-svc-view-tabs button.is-active b {
  color: var(--profile-primary);
}

.employee-profile-page .emp-svc-control-actions {
  display: grid;
  grid-template-columns: repeat(2, max-content);
  gap: 7px;
}

.employee-profile-page .emp-svc-btn,
.employee-profile-page .emp-svc-load-more,
.employee-profile-page .emp-svc-clear-selected {
  min-height: 42px;
  padding: 0 13px;
  border-radius: 10px;
  font-size: 12px;
  font-weight: 900;
  cursor: pointer;
}

.employee-profile-page .emp-svc-btn:disabled {
  opacity: 0.45;
  cursor: not-allowed;
}

.employee-profile-page .emp-svc-btn--primary {
  border: 1px solid var(--profile-primary);
  color: #fff;
  background: var(--profile-primary);
}

.employee-profile-page .emp-svc-btn--ghost {
  border: 1px solid #dbe1e8;
  color: #526075;
  background: #fff;
}

.employee-profile-page .emp-svc-workspace {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 300px;
  align-items: start;
  gap: 14px;
  min-width: 0;
}

.employee-profile-page .emp-svc-catalog,
.employee-profile-page .emp-svc-selected-panel {
  min-width: 0;
  border: 1px solid #e1e5ea;
  border-radius: 15px;
  background: #fff;
}

.employee-profile-page .emp-svc-catalog {
  padding: 14px;
}

.employee-profile-page .emp-svc-catalog__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  margin-bottom: 12px;
  padding: 0 2px 12px;
  border-bottom: 1px solid #edf0f3;
}

.employee-profile-page .emp-svc-catalog__head > div {
  min-width: 0;
}

.employee-profile-page .emp-svc-catalog__head h4,
.employee-profile-page .emp-svc-selected-panel__head h4 {
  margin: 0;
  color: var(--profile-text);
  font-size: 15px;
  font-weight: 950;
}

.employee-profile-page .emp-svc-catalog__head p {
  margin: 3px 0 0;
  color: var(--profile-muted);
  font-size: 11px;
}

.employee-profile-page .emp-svc-catalog__head > span {
  flex: 0 0 auto;
  padding: 5px 9px;
  border-radius: 999px;
  color: #59667a;
  background: #f1f4f7;
  font-size: 11px;
  font-weight: 900;
}

.employee-profile-page .emp-svc-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(190px, 1fr));
  gap: 9px;
  min-width: 0;
}

.employee-profile-page .emp-svc-card {
  position: relative;
  display: grid;
  grid-template-columns: 24px minmax(0, 1fr);
  grid-template-areas:
    "check content"
    "meta meta";
  align-items: start;
  gap: 8px 10px;
  min-width: 0;
  min-height: 88px;
  padding: 12px;
  overflow: hidden;
  border: 1px solid #dfe4ea;
  border-radius: 12px;
  color: #172033;
  background: #fff;
  text-align: right;
  cursor: pointer;
  transition: border-color 150ms ease, background-color 150ms ease, transform 150ms ease, box-shadow 150ms ease;
}

.employee-profile-page .emp-svc-card:hover {
  border-color: #bcc6d2;
  background: #fcfdfe;
  transform: translateY(-1px);
}

.employee-profile-page .emp-svc-card.is-selected {
  border-color: rgba(90, 7, 24, 0.56);
  background: linear-gradient(135deg, #fff 0%, #fff1f4 100%);
  box-shadow: 0 0 0 2px rgba(90, 7, 24, 0.05);
}

.employee-profile-page .emp-svc-card__check {
  grid-area: check;
  display: grid;
  width: 22px;
  height: 22px;
  place-items: center;
  border: 1.5px solid #c8d0da;
  border-radius: 6px;
  color: transparent;
  background: #fff;
  font-size: 12px;
  font-weight: 950;
}

.employee-profile-page .emp-svc-card.is-selected .emp-svc-card__check {
  border-color: var(--profile-primary);
  color: #fff;
  background: var(--profile-primary);
}

.employee-profile-page .emp-svc-card__content {
  grid-area: content;
  min-width: 0;
  padding-inline-end: 48px;
}

.employee-profile-page .emp-svc-card__content strong {
  display: block;
  overflow: hidden;
  color: #172033;
  font-size: 13px;
  font-weight: 950;
  line-height: 1.45;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.employee-profile-page .emp-svc-card__content small {
  display: block;
  margin-top: 2px;
  overflow: hidden;
  color: #788497;
  font-size: 10px;
  font-weight: 750;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.employee-profile-page .emp-svc-card__meta {
  grid-area: meta;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
  padding-top: 7px;
  border-top: 1px solid #eef1f4;
}

.employee-profile-page .emp-svc-card__meta em {
  color: #59667a;
  font-size: 10px;
  font-style: normal;
  font-weight: 850;
  white-space: nowrap;
}

.employee-profile-page .emp-svc-card__badge {
  position: absolute;
  top: 10px;
  left: 10px;
  padding: 3px 7px;
  border-radius: 999px;
  color: var(--profile-primary);
  background: rgba(90, 7, 24, 0.08);
  font-size: 9px;
  font-weight: 950;
}

.employee-profile-page .emp-svc-load-more {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 5px;
  width: 100%;
  margin-top: 11px;
  border: 1px dashed #cfd6df;
  color: #526075;
  background: #fafbfc;
}

.employee-profile-page .emp-svc-empty,
.employee-profile-page .emp-svc-selected-empty {
  display: grid;
  min-height: 130px;
  place-content: center;
  gap: 5px;
  padding: 20px;
  border: 1px dashed #d8dee6;
  border-radius: 12px;
  color: #758195;
  background: #fafbfc;
  text-align: center;
}

.employee-profile-page .emp-svc-empty strong,
.employee-profile-page .emp-svc-selected-empty strong {
  color: #344054;
  font-size: 13px;
}

.employee-profile-page .emp-svc-empty span,
.employee-profile-page .emp-svc-selected-empty span {
  font-size: 11px;
}

.employee-profile-page .emp-svc-selected-panel {
  position: sticky;
  top: 16px;
  display: grid;
  gap: 11px;
  max-height: calc(100vh - 130px);
  padding: 13px;
  overflow: hidden;
}

.employee-profile-page .emp-svc-selected-panel__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  padding-bottom: 10px;
  border-bottom: 1px solid #edf0f3;
}

.employee-profile-page .emp-svc-selected-panel__head > div {
  min-width: 0;
}

.employee-profile-page .emp-svc-selected-panel__head span {
  display: block;
  margin-bottom: 2px;
  color: var(--profile-gold);
  font-size: 10px;
  font-weight: 950;
}

.employee-profile-page .emp-svc-selected-panel__head > b {
  display: grid;
  min-width: 38px;
  height: 38px;
  place-items: center;
  border-radius: 11px;
  color: #fff;
  background: var(--profile-primary);
  font-size: 15px;
}

.employee-profile-page .emp-svc-selected-search {
  display: grid;
  gap: 5px;
}

.employee-profile-page .emp-svc-selected-search input {
  height: 38px;
  font-size: 12px;
}

.employee-profile-page .emp-svc-selected-list {
  display: grid;
  gap: 7px;
  min-height: 0;
  overflow-y: auto;
  padding-inline-end: 2px;
}

.employee-profile-page .emp-svc-selected-item {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 30px;
  align-items: center;
  gap: 8px;
  min-width: 0;
  padding: 9px 10px;
  border: 1px solid #e5e9ee;
  border-radius: 10px;
  background: #fafbfc;
}

.employee-profile-page .emp-svc-selected-item > div {
  min-width: 0;
}

.employee-profile-page .emp-svc-selected-item strong {
  display: block;
  overflow: hidden;
  color: #273246;
  font-size: 12px;
  font-weight: 950;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.employee-profile-page .emp-svc-selected-item span {
  display: block;
  margin-top: 2px;
  overflow: hidden;
  color: #7a8698;
  font-size: 10px;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.employee-profile-page .emp-svc-selected-item button {
  display: grid;
  width: 30px;
  height: 30px;
  place-items: center;
  padding: 0;
  border: 1px solid #f2c7d0;
  border-radius: 8px;
  color: #b4233c;
  background: #fff7f8;
  font-size: 18px;
  line-height: 1;
  cursor: pointer;
}

.employee-profile-page .emp-svc-clear-selected {
  width: 100%;
  min-height: 38px;
  border: 1px solid #f0c8d0;
  color: #a51d36;
  background: #fff7f8;
  font-size: 11px;
}

@media (max-width: 1180px) {
  .employee-profile-page .emp-svc-controlbar {
    grid-template-columns: minmax(220px, 1fr) minmax(170px, 0.7fr) auto;
  }

  .employee-profile-page .emp-svc-control-actions {
    grid-column: 1 / -1;
    justify-content: end;
  }

  .employee-profile-page .emp-svc-workspace {
    grid-template-columns: minmax(0, 1fr) 270px;
  }
}

@media (max-width: 980px) {
  .employee-profile-page .emp-svc-controlbar {
    grid-template-columns: minmax(0, 1fr) minmax(180px, 0.7fr);
  }

  .employee-profile-page .emp-svc-view-tabs,
  .employee-profile-page .emp-svc-control-actions {
    grid-column: auto;
  }

  .employee-profile-page .emp-svc-workspace {
    grid-template-columns: 1fr;
  }

  .employee-profile-page .emp-svc-selected-panel {
    position: static;
    max-height: none;
  }

  .employee-profile-page .emp-svc-selected-list {
    max-height: 360px;
  }
}

@media (max-width: 720px) {
  .employee-profile-page .emp-svc-hero {
    display: grid;
    padding: 15px;
  }

  .employee-profile-page .emp-svc-stats {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .employee-profile-page .emp-svc-controlbar {
    grid-template-columns: 1fr;
  }

  .employee-profile-page .emp-svc-view-tabs,
  .employee-profile-page .emp-svc-control-actions {
    grid-column: auto;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .employee-profile-page .emp-svc-btn {
    width: 100%;
    padding-inline: 8px;
  }

  .employee-profile-page .emp-svc-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

@media (max-width: 520px) {
  .employee-profile-page .emp-svc-grid {
    grid-template-columns: 1fr;
  }

  .employee-profile-page .emp-svc-catalog,
  .employee-profile-page .emp-svc-selected-panel {
    padding: 11px;
    border-radius: 12px;
  }

  .employee-profile-page .emp-svc-catalog__head {
    align-items: flex-start;
  }

  .employee-profile-page .emp-svc-card {
    min-height: 84px;
  }
}
/* EMPLOYEE SERVICES REDESIGN V4 END */
