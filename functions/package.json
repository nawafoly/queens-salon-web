{
  "name": "functions",
  "private": true,
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "lint": "eslint .",
    "build": "node --max-old-space-size=4096 ./node_modules/typescript/bin/tsc",
    "test": "npm run test:unit",
    "test:unit": "npm run build && node --test lib/packageSubscriptionDomain.test.js lib/packageSubscriptionFunctions.test.js",
    "test:emulator": "node --test --test-concurrency=1 lib/packageSubscriptionRules.test.js lib/packageSubscriptionEmulator.test.js",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "dependencies": {
    "firebase-admin": "^12.6.0",
    "firebase-functions": "^6.0.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "@types/node": "^25.2.1",
    "@typescript-eslint/eslint-plugin": "^5.12.0",
    "@typescript-eslint/parser": "^5.12.0",
    "eslint": "^8.9.0",
    "eslint-config-google": "^0.14.0",
    "eslint-plugin-import": "^2.25.4",
    "firebase": "^12.16.0",
    "firebase-functions-test": "^3.1.0",
    "typescript": "^5.7.3"
  }
}
